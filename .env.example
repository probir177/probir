# Claude API কী — https://platform.claude.com থেকে নিন
ANTHROPIC_API_KEY=sk-ant-...

# ওয়েবসাইটে লগইনের পাসওয়ার্ড (কমপক্ষে ৮ অক্ষর)
ADMIN_PASSWORD=change-this-password
# সেশন গোপন কী (কমপক্ষে ৩২ অক্ষর): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# FTP সার্ভারের তথ্য
# FTP_PROTOCOL: auto (নিজে খুঁজে নেবে) | ftp | ftps | sftp
FTP_PROTOCOL=auto
FTP_HOST=ftp.example.com
FTP_PORT=
FTP_USER=
FTP_PASSWORD=
# এআই শুধু এই ফোল্ডারের ভেতরে কাজ করতে পারবে
FTP_ROOT=/
# সার্ভারের TLS সার্টিফিকেট self-signed হলে true দিন
FTP_ALLOW_INSECURE=false

PORT=3000
# HTTPS-এর পেছনে চালালে production দিন (নিরাপদ কুকি)
NODE_ENV=development

# F-Droid সংযোগ (false দিলে বন্ধ)
FDROID_ENABLED=true
# ইনডেক্স কত ঘণ্টা পরপর হালনাগাদ যাচাই হবে
FDROID_REFRESH_HOURS=6
# সর্বোচ্চ কত MB-এর APK ডাউনলোড করা যাবে
FDROID_MAX_APK_MB=300
# ক্যাশ রাখার ফোল্ডার
DATA_DIR=data
# ঐচ্ছিক: GitHub-এ সোর্স কোড দেখার সীমা (ঘণ্টায় ৬০ বার) বাড়াতে একটি read-only টোকেন
GITHUB_TOKEN=

# দোকানের অ্যাপ লাইব্রেরি (FTP-র যে ফোল্ডারে APK থাকে)
LIBRARY_DIR=/apps
# প্রতি অ্যাপের কয়টি পুরোনো ভার্সন _old ফোল্ডারে রাখা হবে
LIBRARY_KEEP_OLD=2
# প্রতি রাতে স্বয়ংক্রিয় আপডেট (true দিলে চালু), সময় সার্ভারের TZ অনুযায়ী
AUTO_UPDATE=false
AUTO_UPDATE_TIME=03:00
TZ=Asia/Dhaka
# ক্যাটালগের শিরোনামে দোকানের নাম
STORE_NAME=
