# Claude API কী — https://platform.claude.com থেকে নিন
ANTHROPIC_API_KEY=sk-ant-...

# ওয়েবসাইটে লগইনের পাসওয়ার্ড (কমপক্ষে ৮ অক্ষর)
ADMIN_PASSWORD=change-this-password
# সেশন গোপন কী (কমপক্ষে ৩২ অক্ষর): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# FTP সার্ভারের তথ্য
# FTP_PROTOCOL: auto (নিজে খুঁজে নেবে) | ftp | ftps | sftp
FTP_PROTOCOL=auto
FTP_HOST=ftp.example.com
FTP_PORT=
FTP_USER=
FTP_PASSWORD=
# এআই শুধু এই ফোল্ডারের ভেতরে কাজ করতে পারবে
FTP_ROOT=/
# সার্ভারের TLS সার্টিফিকেট self-signed হলে true দিন
FTP_ALLOW_INSECURE=false

PORT=3000
# HTTPS-এর পেছনে চালালে production দিন (নিরাপদ কুকি)
NODE_ENV=development
